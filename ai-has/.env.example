# ==============================================================================
# AI-HAS (AI-Powered Enterprise Helpdesk & Workflow Automation System)
# ==============================================================================

# --- OpenAI Configuration ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Database Configuration ---
# SQLite default for zero-config local execution; swap to postgresql+psycopg:// for Postgres
DATABASE_URL=sqlite:///./data/ai_has.db

# --- Vector Store & Knowledge Base ---
CHROMA_PERSIST_DIR=./data/chroma
KNOWLEDGE_BASE_DIR=../knowledge_base

# --- Auth & RBAC ---
# Used to sign/verify JWT bearer tokens. For anything beyond a local demo, set strong values
# (e.g. `openssl rand -hex 32`) -- the backend refuses to start with the shipped defaults
# unless ALLOW_HEADER_ROLE_AUTH=true.
JWT_SECRET=ai-has-enterprise-dev-secret-change-in-production
JWT_ALGORITHM=HS256
# DEMO ONLY: trusts X-User-Role headers (UI role switcher) and exposes POST /api/auth/token.
# The code default is false; this example enables it so the demo UI works out of the box.
ALLOW_HEADER_ROLE_AUTH=true

# --- Webhook Integrations (Optional; uses built-in local sandbox sink if blank) ---
WEBHOOK_TIMEOUT_SECONDS=8.0
WEBHOOK_MAX_RETRIES=2
WEBHOOK_RETRY_BACKOFF_SECONDS=0.5
# Jira: POST to .../rest/api/2/issue (native issue body). ServiceNow: .../api/now/table/incident.
JIRA_WEBHOOK_URL=
JIRA_PROJECT_KEY=ITSD
JIRA_AUTHORIZATION=
SERVICENOW_WEBHOOK_URL=
SERVICENOW_AUTHORIZATION=
# n8n / Make receive the full signed event envelope.
N8N_WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=ai-has-webhook-hmac-secret

# --- Server & Frontend ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
LOG_LEVEL=INFO
